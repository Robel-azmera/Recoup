{
  "name": "recoup",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:web": "pnpm --filter @recoup/web dev",
    "gen:types": "pnpm --filter @recoup/shared gen:types",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"apps/web/src/**/*.{ts,tsx,css}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
