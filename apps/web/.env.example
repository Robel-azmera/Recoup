# Copy to apps/web/.env.local
VITE_API_URL=http://localhost:8080

# Firebase web config (public values). For the local emulator only the project id matters.
VITE_FIREBASE_PROJECT_ID=demo-recoup
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
# Set to the emulator host to use it (unset in prod)
VITE_FIRESTORE_EMULATOR_HOST=localhost:8081
