# Copy to apps/api/.env — never commit the real file.
ENV=local                         # local | prod
WEB_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:8080

# Firestore: the emulator is used whenever FIRESTORE_EMULATOR_HOST is set.
FIRESTORE_PROJECT_ID=demo-recoup
FIRESTORE_EMULATOR_HOST=localhost:8081

# Auth (demo single-admin login) + signing secrets
ADMIN_PASSWORD=change-me
SESSION_SECRET=dev-session-secret-change-me
APPROVAL_SECRET=dev-approval-secret-change-me

# Job endpoints: shared secret locally; OIDC (Cloud Scheduler) in prod
JOB_SHARED_SECRET=dev-job-secret
SCHEDULER_AUDIENCE=                # e.g. https://recoup-api-xxxx.run.app
SCHEDULER_SA_EMAIL=                # service account Scheduler signs tokens with

# Stripe (test mode). Empty => in-memory mock Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Gemini. Empty => deterministic mock drafter.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM=8

# Telegram. Empty => mock (logged to audit_log).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=dev-telegram-secret

# Google Calendar (service account JSON, inline or path). Empty => mock.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Resend. Empty => mock.
RESEND_API_KEY=
EMAIL_FROM=Recoup <onboarding@resend.dev>
OWNER_EMAIL=
